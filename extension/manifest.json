{
	"manifest_version": 3,
	"name": "ReplyTrack",
	"version": "1.1.0",
	"description": "Copies LinkedIn message replies into your team's Google Sheet automatically.",
	"permissions": ["storage", "alarms", "notifications", "idle", "cookies"],
	"host_permissions": [
		"https://www.linkedin.com/*",
		"https://script.google.com/*",
		"https://script.googleusercontent.com/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://www.linkedin.com/messaging/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_title": "ReplyTrack",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
